# ==============================================================
# SECURITY HARDENING
# ==============================================================

# Disable directory listing/browsing
Options -Indexes

# Disable server signature
ServerSignature Off

# ==============================================================
# CUSTOM ERROR PAGES
# ==============================================================
ErrorDocument 400 /errors/403.html
ErrorDocument 401 /errors/403.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/500.html
ErrorDocument 503 /errors/503.html

# Security Headers
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, nosnippet, noarchive"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ==============================================================
# BLOCK SENSITIVE FILES
# ==============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow error pages to be served
    RewriteRule ^errors/ - [L]

    # Block dotfiles (.htaccess, .git, .env, .user.ini, etc) except .well-known
    RewriteCond %{REQUEST_URI} "!(^|/)\.well-known(/|$)" [NC]
    RewriteRule "(^|/)\." - [F,L]

    # Block sensitive files by extension (only in root, not assets)
    RewriteCond %{REQUEST_URI} !^/assets/ [NC]
    RewriteCond %{REQUEST_URI} !^/errors/ [NC]
    RewriteRule \.(sql|tar|gz|zip|bak|old|log|ini|md|rst|xml|yml|yaml)$ - [F,L]

    # Block adminer.php and db files
    RewriteRule ^adminer\.php$ - [F,L]
    RewriteRule ^db\.(php|json|sql)$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # Block application, system, websocket, log directories from direct access
    RewriteRule ^(application|system|websocket|log)(/.*)$ - [F,L]

    # CodeIgniter front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule .* index.php/$0 [PT,L]
</IfModule>

# ==============================================================
# BLOCK ACCESS TO SENSITIVE FILE TYPES (fallback)
# ==============================================================
<FilesMatch "\.(sql|tar|gz|zip|bak|old|log|ini|env|git|svn)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Block specific dangerous files
<FilesMatch "^(adminer|db|composer|changelog|contributing|readme|license)\.(php|json|sql|md|rst|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# ==============================================================
# PHP SETTINGS
# ==============================================================

<IfModule mod_php5.c>
    php_value max_input_vars 100000
    php_value post_max_size 100M
    php_value upload_max_filesize 100M
</IfModule>

<IfModule mod_php7.c>
    php_value max_input_vars 100000
    php_value post_max_size 100M
    php_value upload_max_filesize 100M
</IfModule>

<IfModule mod_php8.c>
    php_value max_input_vars 100000
    php_value post_max_size 100M
    php_value upload_max_filesize 100M
</IfModule>